{
  "ConnectionStrings": {
    "SafeSchool": "Host=localhost;Database=safeschool;Username=safeschool;Password=safeschool"
  },
  "Jwt": {
    "Authority": "https://identity.local",
    "Audience": "safeschool-api"
  },
  "Audit": {
    "RequireSensitiveActionAudit": true
  },
  "FeatureSettings": {
    "DefaultAvailability": "Disabled"
  },
  "AttendanceAccess": {
    "OfflineClockDriftToleranceMinutes": 15,
    "MaxOfflineSyncBatchSize": 250,
    "ScanSyncRetentionDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Transport": {
    "ScanSyncLimits": {
      "MaxBatchSize": 500,
      "ClockDriftToleranceMinutes": 3
    },
    "MobileTracking": {
      "LocationStalenessThresholdSeconds": 120,
      "RetryLimit": 5
    },
    "Retention": {
      "DetailedLocationDays": 30
    },
    "FeatureFlags": {
      "DefaultTransportAvailability": "Enabled"
    }
  },
  "Wallet": {
    "TopUpLimits": {
      "MinimumMinor": 100,
      "MaximumMinor": 500000,
      "CashierThresholdMinor": 100000
    },
    "PaymentProvider": {
      "Adapter": "ConfiguredProvider",
      "StoreRawPayloads": false
    },
    "PosOfflineReserves": {
      "EnabledByDefault": false,
      "PerStudentReserveMinor": 2500,
      "PerTerminalReserveMinor": 50000
    },
    "Retention": {
      "DetailedFinancialRecordDays": 365,
      "PreserveActiveReviewHolds": true
    },
    "DuplicateRetryLimits": {
      "ClientRequestWindowMinutes": 60,
      "ProviderEventWindowDays": 30
    }
  },
  "Learning": {
    "GuardianVisibility": {
      "DefaultPolicy": "summary",
      "HideStaffOnlyDetails": true
    },
    "StatusEvents": {
      "ExportEnabled": true,
      "NotificationReadinessWindowMinutes": 2,
      "Phase6StarEvidenceWindowMinutes": 2
    },
    "DuplicateRetryLimits": {
      "ClientRequestWindowMinutes": 60,
      "OverlapThresholdMinutes": 5
    },
    "Summaries": {
      "RefreshWindowMinutes": 15,
      "HistoryLookbackDays": 90
    },
    "Audit": {
      "RequireSensitiveActionAudit": true,
      "RedactSensitivePayloads": true
    }
  },
  "Complaints": {
    "TargetResponseHours": 24,
    "EscalationWindowMinutes": 60,
    "StatusEventExportEnabled": true,
    "AuditRequired": true
  },
  "Communications": {
    "NotificationReadinessWindowMinutes": 2,
    "DeliveryAttemptWindowMinutes": 5,
    "QuietHoursEnabled": true,
    "AuditRequired": true
  },
  "Documents": {
    "ObjectStorageProvider": "S3Compatible",
    "SearchFreshnessMinutes": 5,
    "RetentionProtectionEnabled": true,
    "LegalHoldEnabled": true
  },
  "Administration": {
    "DashboardRefreshSeconds": 30,
    "AuditTraceTimeoutSeconds": 60,
    "MetricBreachVisibilityMinutes": 5
  },
  "Mobile": {
    "EnabledByDefault": true,
    "ApkReleaseEnabled": true,
    "SupportedLanguages": [ "ar", "en" ],
    "RevocationWindowMinutes": 5,
    "SupportEvidenceLookupMinutes": 2,
    "ControlledApkArtifacts": {
      "Provider": "S3Compatible",
      "RequireChecksum": true
    }
  }
}
