FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL
ARG SAFE_SCHOOL_API_BASE_URL
ARG NEXT_PUBLIC_REQUIRE_API_DATA=1
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV SAFE_SCHOOL_API_BASE_URL=$SAFE_SCHOOL_API_BASE_URL
ENV NEXT_PUBLIC_REQUIRE_API_DATA=$NEXT_PUBLIC_REQUIRE_API_DATA
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ARG NEXT_PUBLIC_API_BASE_URL
ARG SAFE_SCHOOL_API_BASE_URL
ARG NEXT_PUBLIC_REQUIRE_API_DATA=1
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV SAFE_SCHOOL_API_BASE_URL=$SAFE_SCHOOL_API_BASE_URL
ENV NEXT_PUBLIC_REQUIRE_API_DATA=$NEXT_PUBLIC_REQUIRE_API_DATA

COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/.next ./.next

EXPOSE 3000
CMD ["npm", "run", "start"]
